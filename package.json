{
  "name": "palworld-companion",
  "version": "0.1.0",
  "description": "Companion service for the Palworld dedicated server Docker image: web operation panel and Discord live status card",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx watch --env-file=dev/dev.env src/index.ts",
    "mock": "tsx dev/mock-palserver.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "discord.js": "14.27.0",
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
