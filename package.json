{
  "name": "palworld-companion",
  "version": "0.1.0",
  "description": "Companion service for the Palworld dedicated server Docker image: web operation panel and Discord live status card",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx watch src/index.ts",
    "mock": "tsx dev/mock-palserver.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "hono": "4.12.32"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.25.12",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
