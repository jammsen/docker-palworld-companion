# Minimal standalone example - dummy values that let the companion start.
# The RECOMMENDED setup is the integrated one from the gameserver repo, where
# gameserver + companion run from ONE compose.yml and share ONE default.env
# (it contains the full companion section, disabled by default):
#   https://github.com/jammsen/docker-palworld-dedicated-server
# Every variable is documented in docs/ENV_VARS.md.
PANEL_ENABLED=true
PANEL_PASSWORD=webpanelPasswordHere
# The gameserver's REST API: hostname (compose service name), port and the
# ADMIN_PASSWORD must match what the gameserver container uses
RESTAPI_ENABLED=true
RESTAPI_HOST=palworld-dedicated-server
RESTAPI_PORT=8212
ADMIN_PASSWORD=adminPasswordHere
DISCORD_STATUS_ENABLED=false
