# Host-side development env, loaded by `npm run dev` via --env-file (pair it
# with `npm run mock` as the fake gameserver). Container setups never use this
# file - they use default.env (standalone example) or the gameserver repo's
# shared default.env (recommended integrated setup).
COMPANION_DEBUG=true
GAME_ROOT=./tmp-gameroot
COMPANION_ICONS_DIR=./icons

PANEL_ENABLED=true
PANEL_PORT=8213
PANEL_USERNAME=admin
PANEL_PASSWORD=local-dev-password
PANEL_DEFAULT_LANGUAGE=en

DISCORD_STATUS_ENABLED=false
DISCORD_STATUS_WEBHOOK_URL=
DISCORD_STATUS_UPDATE_INTERVAL=30
# Bot mode (set a token to switch from webhook to bot) - see docs/ENV_VARS.md "Bot mode"
#DISCORD_BOT_TOKEN=
#DISCORD_STATUS_CHANNEL_ID=
#DISCORD_LOGS_CHANNEL_ID=
#DISCORD_ADMIN_CHANNEL_ID=
#DISCORD_PRESENCE_ENABLED=true
# Slash commands need the guild id AND the flag
#DISCORD_GUILD_ID=
#DISCORD_COMMANDS_ENABLED=false

# Point at `npm run mock` (dev/mock-palserver.ts) or a real container's published 8212
RESTAPI_ENABLED=true
RESTAPI_PORT=8212
RESTAPI_TIMEOUT=10
ADMIN_PASSWORD=local-dev-admin
